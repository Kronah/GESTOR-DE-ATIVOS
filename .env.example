# --- BACKEND ---

# Banco de dados Local (SQLite)
# DATABASE_URL="file:./prisma/dev.db"

# Banco de dados Nuvem (PostgreSQL)
# Exemplo Neon/Render: postgres://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

PORT=4000
VALIDATION_PORT=4100

# --- FRONTEND ---

# URL publica do backend para o frontend (mude para http://localhost:4000 para uso local)
VITE_API_BASE_URL=https://seu-backend.onrender.com
VITE_BASE_PATH=/

# Credenciais do sistema
VITE_ACCESS_USER=admin
VITE_ACCESS_PASSWORD=admin123