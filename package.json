{
  "name": "gesto-de-ativos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "concurrently \"npm run dev:server\" \"npm run dev:cadastro\" \"npm run dev:validador\" \"npm run dev:painel\"",
    "dev:cloud": "concurrently \"npm run dev:server\" \"npm run dev:cadastro\" \"npm run dev:validador\" \"npm run dev:painel\"",
    "dev:client": "vite",
    "dev:cadastro": "cross-env VITE_APP_VIEW=cadastro vite",
    "dev:validador": "cross-env VITE_APP_VIEW=camera vite",
    "dev:painel": "cross-env VITE_APP_VIEW=painel vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server/dist/index.js",
    "start:local": "node server/dist/index.js",
    "start:cloud": "node server/dist/index.js",
    "prisma:generate": "npm run prisma:generate:local",
    "prisma:migrate": "npm run prisma:migrate:local",
    "prisma:generate:local": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:local": "prisma migrate dev --name init --schema prisma/schema.prisma",
    "prisma:generate:cloud": "prisma generate --schema prisma/schema.cloud.prisma",
    "prisma:push:cloud": "prisma db push --schema prisma/schema.cloud.prisma",
    "prisma:migrate:cloud": "prisma migrate deploy --schema prisma/schema.cloud.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "multer": "^2.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/jspdf": "^1.3.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prisma": "^6.17.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
